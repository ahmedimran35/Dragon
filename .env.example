# Copy to .env (git-ignored) and fill in what you use. Values are read by
# config.toml via ${VAR} and by docker-compose. Never commit real keys.

# --- model provider keys (referenced from [llm].api_key and friends) ----------
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Dragon settings (all optional; they take precedence over config.toml) ----
# Path to the TOML config file (default: config/config.toml, then ~/.dragon/config.toml)
# DRAGON_CONFIG=config/config.toml
# Where memory, goals, vault, audit log and sessions live (default ~/.dragon, /data in Docker)
# DRAGON_DATA_DIR=~/.dragon
# The agent's files (default: ./workspace when the current directory has one, else <data_dir>/workspace)
# DRAGON_WORKSPACE=./workspace

# --- the [llm] slot: the chat model ------------------------------------------
# openai | openai_responses | chatgpt | a catalogue id (deepseek, bailian, openrouter, ...)
# DRAGON_LLM_PROVIDER=openai
# DRAGON_LLM_MODEL=deepseek-flash
# DRAGON_LLM_BASE_URL=https://api.deepseek.com
# DRAGON_LLM_API_KEY=
# auto | native | prompt (function calling, with or without a fallback to prompt tools)
# DRAGON_LLM_TOOL_MODE=auto

# --- the [gui] slot: the screen operator's vision model -----------------------
# DRAGON_GUI_ENABLED=false
# DRAGON_GUI_PROVIDER=openai
# DRAGON_GUI_MODEL=
# DRAGON_GUI_BASE_URL=
# DRAGON_GUI_API_KEY=

# --- the [image] and [video] slots: the avatar studio -------------------------
# DRAGON_IMAGE_PROVIDER=
# DRAGON_IMAGE_MODEL=
# DRAGON_IMAGE_BASE_URL=
# DRAGON_IMAGE_API_KEY=
# DRAGON_VIDEO_PROVIDER=
# DRAGON_VIDEO_MODEL=
# DRAGON_VIDEO_BASE_URL=
# DRAGON_VIDEO_API_KEY=

# --- behaviour ----------------------------------------------------------------
# ask | strict | auto (the Sentinel's approval mode)
# DRAGON_SENTINEL_MODE=ask
# DEBUG | INFO | WARNING
# DRAGON_LOG_LEVEL=INFO
# base64 Fernet key for the credential vault (default: a key file in the data dir)
# DRAGON_VAULT_KEY=
# the browser tool (also needs: pip install "dragon[browser]" && playwright install chromium)
# DRAGON_BROWSER_ENABLED=false
# auto | bwrap | off (shell/python sandboxing on Linux)
# DRAGON_SANDBOX=auto

# --- the web app (`dragon serve`) ---------------------------------------------
# DRAGON_SERVER_HOST=127.0.0.1
# DRAGON_SERVER_PORT=8787
# a fixed access token (default: generated once into <data_dir>/server_token)
# DRAGON_SERVER_TOKEN=
# on = token required (default); off = development only, never on a network
# DRAGON_SERVER_AUTH=on
