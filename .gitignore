# local configuration & secrets
config/config.toml
config/*.local.toml
.env
.env.*
*.env
!.env.example

# runtime data
workspace/
*.db
*.enc
*.key
audit.jsonl
sessions/
logs/

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# web app: sources in web/ are tracked, node_modules and scratch builds are not.
# The production build in dragon/server/static IS tracked: the Python package ships it,
# so `pip install dragon` works without Node. `cd web && npm run build` writes it; commit
# the result with the change that caused it.
web/node_modules/
web/dist/
web/.vite/
*.tsbuildinfo
npm-debug.log*

# editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# uv lockfile: the project installs with `uv pip install -e .`, not `uv sync`
uv.lock
